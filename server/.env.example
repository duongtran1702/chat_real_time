# Khóa AI dùng cho @CloseFriend
AI_KEY=

# Chế độ chạy trên máy. Render phải đổi thành cloud.
SPRING_PROFILES_ACTIVE=local

# Mật khẩu MySQL cục bộ
DB_PASS=

# Tài khoản Cloudinary dùng để lưu ảnh đại diện
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Render/cloud: lấy từ Supabase > Connect > Session pooler > JDBC.
# Không commit mật khẩu thật vào GitHub.
# DB_URL=jdbc:postgresql://<SUPABASE_POOLER_HOST>:5432/postgres?sslmode=require
# DB_USERNAME=postgres.<PROJECT_REF>
# DB_PASSWORD=<SUPABASE_DATABASE_PASSWORD>

# Khóa ký JWT, bắt buộc dùng chuỗi bí mật dài ở production.
JWT_SECRET_KEY=
