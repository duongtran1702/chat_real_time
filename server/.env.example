# Khóa AI dùng cho @CloseFriend
AI_KEY=

# Chế độ chạy trên máy. Railway phải đổi thành cloud.
SPRING_PROFILES_ACTIVE=local

# Mật khẩu MySQL cục bộ
DB_PASS=

# Tài khoản Cloudinary dùng để lưu ảnh đại diện
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Railway/cloud: bỏ comment và điền bằng biến tham chiếu từ MySQL Railway.
# DB_URL=jdbc:mysql://<MYSQLHOST>:<MYSQLPORT>/<MYSQLDATABASE>
# DB_USERNAME=<MYSQLUSER>
# DB_PASSWORD=<MYSQLPASSWORD>

# Khóa ký JWT, bắt buộc dùng chuỗi bí mật dài ở production.
JWT_SECRET_KEY=
